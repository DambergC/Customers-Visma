}


$buttonLoadConfiguration_Click = {
	#TODO: Place custom script here
	
	$ScriptDirectory
	
	$file = "$ScriptDirectory\ScriptConfig.XML"
	$xml = [XML](get-content $file)
	$OutputWindow.AppendText($ScriptDirectory)
	
	if ($xml.configuration.EnableTest -eq '0')
	{
		$checkboxTest.Checked = $false
		$SQLServerTEST.Enabled = $false
		$SQLDataPath.Enabled = $false
		$SQLLogpath.Enabled = $false
		$Importpath.Enabled = $false
		$ExportPath.Enabled = $false
		$BIGRAMTESTbox.Enabled = $false
		$RestorepathSQL.Enabled = $false
		$buttonRestoreToTestDB.Enabled = $false
		$buttonRunQueryToFixTESTDB.Enabled = $false
		$buttonShowRestoreQuery.Enabled = $false
		$buttonShowFixQuery.Enabled = $false
	}
	else
	{
		$checkboxTest.Checked = $true
		$SQLServerTEST.Enabled = $true
		$SQLDataPath.Enabled = $true
		$SQLLogpath.Enabled = $true
		$Importpath.Enabled = $true
		$ExportPath.Enabled = $true
		$BIGRAMPRODbox.Enabled = $true
		$RestorepathSQL.Enabled = $true
		$buttonRestoreToTestDB.Enabled = $true
		$buttonRunQueryToFixTESTDB.Enabled = $true
		$buttonShowRestoreQuery.Enabled = $true
		$buttonShowFixQuery.Enabled = $true
	}
	
	if ($xml.configuration.EnableProd -eq '0')
	{
		$checkboxTest.Checked = $false
		$SQLServerprod.Enabled = $false
		$BIGRAMPRODbox.Enabled = $false
		$backuppathSQL.Enabled = $false
		$buttonBackupProdDB.Enabled = $false
		$buttonShowBackupQuery.Enabled = $false
	}
	else
	{
		$CheckboxProduktion.Checked = $true
		$SQLServerprod.Enabled = $true
		$BIGRAMTESTbox.Enabled = $true
		$backuppathSQL.Enabled = $true
		$buttonBackupProdDB.Enabled = $true
		$buttonShowBackupQuery.Enabled = $true
	}
	
	# prod
	$BigramPRODBox.Clear()
	$SQLserverPROD.Clear()
	$BackupPathSQL.Clear()
	$BigramPRODBox.AppendText($xml.configuration.prod.bigram)
	$SQLserverPROD.AppendText($xml.configuration.prod.sqlserver)
	$BackuppathSQL.AppendText($xml.configuration.prod.BackupPath)
	
	# test
	$BIGRAMTESTbox.Clear()
	$SQLServerTEST.Clear()
	$SQLDataPath.Clear()
	$SQLLogpath.Clear()
	$Importpath.Clear()
	$ExportPath.Clear()
	$RestorepathSQL.Clear()
	
	$BIGRAMTESTbox.AppendText($xml.configuration.test.bigram)
	$SQLServerTEST.AppendText($xml.configuration.test.sqlserver)
	$SQLDataPath.AppendText($xml.configuration.test.RestorePathData)
	$SQLLogpath.AppendText($xml.configuration.test.RestorePathLog)
	$Importpath.AppendText($xml.configuration.test.ImportPath)
	$ExportPath.AppendText($xml.configuration.test.ExportPath)
	$RestorepathSQL.AppendText($xml.configuration.test.RestorePath)
	
}


#region Control Helper Functions
function Show-NotifyIcon
{
<#
	.SYNOPSIS
		Displays a NotifyIcon's balloon tip message in the taskbar's notification area.
	
	.DESCRIPTION
		Displays a NotifyIcon's a balloon tip message in the taskbar's notification area.
		
	.PARAMETER NotifyIcon
     	The NotifyIcon control that will be displayed.
	
	.PARAMETER BalloonTipText
     	Sets the text to display in the balloon tip.
	
	.PARAMETER BalloonTipTitle
		Sets the Title to display in the balloon tip.
	
	.PARAMETER BalloonTipIcon	
		The icon to display in the ballon tip.
	
	.PARAMETER Timeout	
		The time the ToolTip Balloon will remain visible in milliseconds. 
		Default: 0 - Uses windows default.
#>
	param (
		[Parameter(Mandatory = $true, Position = 0)]
		[ValidateNotNull()]
		[System.Windows.Forms.NotifyIcon]$NotifyIcon,
		[Parameter(Mandatory = $true, Position = 1)]
		[ValidateNotNullOrEmpty()]
		[String]$BalloonTipText,
		[Parameter(Position = 2)]
		[String]$BalloonTipTitle = '',
		[Parameter(Position = 3)]
		[System.Windows.Forms.ToolTipIcon]$BalloonTipIcon = 'None',
		[Parameter(Position = 4)]
		[int]$Timeout = 0
	)
	
	if ($null -eq $NotifyIcon.Icon)
	{
		#Set a Default Icon otherwise the balloon will not show
		$NotifyIcon.Icon = [System.Drawing.Icon]::ExtractAssociatedIcon([System.Windows.Forms.Application]::ExecutablePath)
	}
	
	$NotifyIcon.ShowBalloonTip($Timeout, $BalloonTipTitle, $BalloonTipText, $BalloonTipIcon)
}



#endregion

$buttonTestConnection_Click = {
	#TODO: Place custom script here
	
	$richtextbox1.AppendText('Start checking ports PROD')
	$richtextbox1.AppendText("`n")
	
	if (Test-NetConnection -Port 1433 -ComputerName $SQLserverPROD.text -InformationLevel Quiet)
	{
		$PROD1433.BackColor = 'Green'
		$PROD1433.ForeColor = 'White'
	}
	
	else
	{
		$PROD1433.BackColor = 'red'
		$PROD1433.ForeColor = 'White'
	}
	
	
	if (Test-NetConnection -Port 445 -ComputerName $SQLserverPROD.text -InformationLevel Quiet)
	{
		$PROD445.BackColor = 'Green'
		$PROD445.ForeColor = 'White'
	}
	
	else
	{
		$PROD445.BackColor = 'red'
		$PROD445.ForeColor = 'White'
	}
	
	$richtextbox1.AppendText('Start checking ports TEST')
	$richtextbox1.AppendText("`n")
	
	if (Test-NetConnection -Port 1433 -ComputerName $SQLServerTEST.text -InformationLevel Quiet)
	{
		$TEST1433.BackColor = 'Green'
		$TEST1433.ForeColor = 'White'
	}
	
	else
	{
		$TEST1433.BackColor = 'red'
		$TEST1433.ForeColor = 'White'
	}
	
	
	if (Test-NetConnection -Port 445 -ComputerName $SQLServerTEST.text -InformationLevel Quiet)
	{
		$TEST445.BackColor = 'Green'
		$TEST445.ForeColor = 'White'
	}
	
	else
	{
		$TEST445.BackColor = 'red'
		$TEST445.ForeColor = 'White'
	}
	
	$richtextbox1.AppendText('Testing done!')
	$richtextbox1.AppendText("`n")
}


$SaveSettings_Click = {
	#TODO: Place custom script here
	
	
	
	#skapa xml-dokument
	$xmlWriter = New-Object System.XMl.XmlTextWriter("$ScriptDirectory\ScriptConfig.XML", $null)
	$xmlWriter.Formatting = 'Indented'
	$xmlWriter.Indentation = 1
	$XmlWriter.IndentChar = "`t"
	
	$xmlWriter.WriteStartDocument()
	
	$xmlWriter.WriteStartElement("Configuration") # Configuration Startnode
	
	if ($CheckboxProduktion.Checked)
	{
		$xmlWriter.WriteElementString("EnableProd", "1")
	}
	else
	{
		$xmlWriter.WriteElementString("EnableProd", "0")
	}
	
	if ($checkboxTest.Checked)
	{
		$xmlWriter.WriteElementString("EnableTest", "1")
	}
	else
	{
		$xmlWriter.WriteElementString("EnableTest", "0")
	}
	$xmlWriter.WriteStartElement("Prod") # Prod Startnode
	
	$xmlWriter.WriteElementString("Bigram", $BigramPRODBox.text)
	$xmlWriter.WriteElementString("SqlServer", $SQLserverPROD.text)
	$xmlWriter.WriteElementString("BackupPath", $BackuppathSQL.text)
	$xmlWriter.WriteEndElement() # Prod endnode
	
	$xmlWriter.WriteStartElement("Test") # Test Startnode
	
	$xmlWriter.WriteElementString("Bigram", $BIGRAMTESTbox.text)
	$xmlWriter.WriteElementString("SqlServer", $SQLserverTEST.text)
	$xmlWriter.WriteElementString("RestorePath", $RestorepathSQL.text)
	$xmlWriter.WriteElementString("RestorePathData", $SQLDataPath.text)
	$xmlWriter.WriteElementString("RestorePathLog", $SQLLogpath.text)
	$xmlWriter.WriteElementString("ImportPath", $Importpath.text)
	$xmlWriter.WriteElementString("ExportPath", $ExportPath.text)
	$xmlWriter.WriteEndElement() # Test endnode
	
	if ($checkboxPAG.Checked)
	{
		$xmlWriter.WriteElementString("PAG", "1")
	}
	else
	{
		$xmlWriter.WriteElementString("PAG", "0")
	}
	
	if ($checkboxPPP.Checked)
	{
		$xmlWriter.WriteElementString("PPP", "1")
	}
	else
	{
		$xmlWriter.WriteElementString("PPP", "0")
	}
	
	
	if ($checkboxPUD.Checked)
	{
		$xmlWriter.WriteElementString("PUD", "1")
	}
	else
	{
		$xmlWriter.WriteElementString("PUD", "0")
	}
	
	
	if ($checkboxPFH.Checked)
	{
		$xmlWriter.WriteElementString("PFH", "1")
	}
	else
	{
		$xmlWriter.WriteElementString("PFH", "0")
	}
	
	
	$xmlWriter.WriteEndElement() # Configuration endnode
	$xmlWriter.Flush()
	$xmlWriter.Close()
	
}
]]></Code>
