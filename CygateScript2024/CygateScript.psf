$buttonDeleteBigram_Click = {
	$selectedBigram = $BigramListBox.SelectedItem
	
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to delete $selectedBigram"
	$MessageTitle = "Delete Bigram File"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		
		$source = "$InstallDrive\visma\install\backup\appsettings\$selectedBigram.XML"
		$richtextbox1.AppendText("Deleting: $source")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
		
		Remove-Item -Path $source -Force -ErrorAction SilentlyContinue
		
		Write-Log -Level INFO -Message "Bigram $selectedBigram removed"
		Write-Log -Level INFO -Message "path $source"
		update-config
	}
}

$buttonStopServices_Click = {
	
	
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	if ($selectedBackupfolder -eq $null -or $selectedBigram -eq $null)
	{
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Please Select Bigram or backupfolder")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
	}
	
	else
	{
		
		
		$result = @()
		
		
		$services = "PBSScheduler_$selectedBigram","Scheduler", "Ciceron Server Manager", "NeptuneMB_$selectedBigram", "PersonecPBatchManager$selectedBigram", "PersonecPUtdataExportImportService$selectedBigram", "RSPFlexService$selectedBigram", "Visma.P-Background-Service - $selectedBigram", "Visma.PersonecP.PufIa.WinSvc - $selectedBigram"
		

		
		
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Stopping Services ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		

		
		foreach ($service in $services)
		{
			$res = Get-CimInstance win32_service | Where-Object Name -eq $Service | Select-Object name, startname, state, Startmode -ErrorAction SilentlyContinue
			$result += $res
		}
		
		$xmlData = $result | ConvertTo-Xml -NoTypeInformation
		
		# Save the XML data to a file
		$xml_exist = (Test-Path -Path "$InstallDrive\Visma\Install\backup\$selectedBackupfolder\ServicesRestorePoint.xml")
		
		if ($xml_exist -eq $false)
		{
			$xmlData.Save("$InstallDrive\Visma\Install\backup\$selectedBackupfolder\ServicesRestorePoint.xml")
			
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             Service Restore File created in backupfolder ")
			
			
		}
		
		
		Write-Log -Level INFO -Message "***************************************************************"
		Write-Log -Level INFO -Message "Stopping Services --------------"
		
		
		$progressbaroverlay1.Maximum = $services.Count
		$progressbaroverlay1.Step = 1
		$progressbaroverlay1.Value = 0
		
		
		foreach ($Service in $Services)
		{
			
			$checkservice = Get-Service -Name $Service -ErrorAction SilentlyContinue
			
			if ($checkservice -eq $null)
			{
				
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             $Service does not exist ")
				$richtextbox1.ScrollToCaret()
				$progressbaroverlay1.PerformStep()
			}
			
			else
			{
				Stop-Service -Name $Service -Force -ErrorAction SilentlyContinue -Verbose
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             $Service Stopped ")
				$richtextbox1.ScrollToCaret()
				$progressbaroverlay1.PerformStep()
				
				Write-Log -Level INFO -Message "$Service Stopped!"
			}
			
		}
		Write-Log -Level INFO -Message "***************************************************************"
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Services STOPPED")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
	}
}

