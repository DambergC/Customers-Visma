			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("****************************************************************")
			$richtextbox1.ScrollToCaret()
			
		}
		else
		{
			
			###################################
			# INVENTORY OF SSO setting
			###################################	
			$UseSSOBackup = (Test-path -Path "$InstallDrive\Visma\install\backup\$selectedBackupfolder\Wwwroot\$selectedBigram\$selectedBigram\Login\Web.config")
			
			if ($UseSSOBackup -eq $true)
			{
				
				[XML]$UseSSO = Get-Content "$InstallDrive\Visma\install\backup\$selectedBackupfolder\Wwwroot\$selectedBigram\$selectedBigram\Login\Web.config" -ErrorAction SilentlyContinue
				
				
				$object = New-Object -TypeName PSObject
				$object | Add-Member -MemberType NoteProperty -Name 'useSSO' -Value $usesso.configuration.appsettings.add.where{ $_.key -eq 'UseSSo' }.value
				
				$data3 += $object
				
				$result = $data3 | Out-String
				$richtextbox1.Clear()
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("****************************************************************")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             INVENTORY SETTINGS          ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("****************************************************************")
				
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             Use SSO ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             Settings from backup: $result")
				$richtextbox1.ScrollToCaret()
				Write-Log -Level INFO -Message "******************************************************************************"
				Write-Log -Level INFO -Message " UseSSO   ---------------------"
				Write-Log -Level INFO -Message "******************************************************************************"
				
				Write-Log -Level INFO -Message "Settings from backup: $result"
				
				
			}
			
			Else
			{
				
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             Use SSO ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             No web.config present  ")
				$richtextbox1.ScrollToCaret()
				Write-Log -Level INFO -Message "******************************************************************************"
				Write-Log -Level INFO -Message " UseSSO   ---------------------"
				Write-Log -Level INFO -Message "******************************************************************************"
				
				Write-Log -Level INFO -Message "No web.config present"
				
			}
			
			###################################
			# INVENTORY for license.json
			###################################	
			
			$haveLicensJSON = (Test-path -Path "$InstallDrive\Visma\install\backup\$selectedBackupfolder\Wwwroot\$selectedBigram\PIP\IntegrationApi\license.json")
			
			if ($haveLicensJSON -eq $true)
				{
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             Integration API ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             license.json exist")
				$richtextbox1.ScrollToCaret()
				Write-Log -Level INFO -Message "******************************************************************************"
				Write-Log -Level INFO -Message " Integration API   ---------------"
				Write-Log -Level INFO -Message "******************************************************************************"
				
				Write-Log -Level INFO -Message "Settings from backup: license.json exist"
				}
				
				else
			{
				
				
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             Integration API")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             No License.json... ")
				$richtextbox1.ScrollToCaret()
				Write-Log -Level INFO -Message "******************************************************************************"
				Write-Log -Level INFO -Message " Integration API    ---------------"
				Write-Log -Level INFO -Message "******************************************************************************"
				
				Write-Log -Level INFO -Message "No License.json..."
				
			}
				
				
			}
			
			
		}
		
		
		
		
		
		
	}
	
	$buttonPassword_Click = {
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	$selectedBigram = $BigramListBox.SelectedItem
	
	$data5 = @()
	
	
	$pstid = Get-IniFile "$InstallDrive\Visma\install\backup\$selectedBackupfolder\programs\$selectedBigram\ppp\Personec_p\pstid.ini" -ErrorAction SilentlyContinue
