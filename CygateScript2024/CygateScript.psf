$BackupFolderListbox_SelectedIndexChanged = {
	
	
	
	
	
	$selectedItems = $BackupFolderListbox.SelectedItems
	
	$Backupfolder = $BackupFolderListbox.SelectedItem
	$richtextbox1.AppendText("`n")
