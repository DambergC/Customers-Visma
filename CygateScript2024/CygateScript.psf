	$file = $BigramListBox.selecteditem
	
	[XML]$xmlValues = Get-Content "$InstallDrive\Visma\install\backup\appsettings\$file.XML"
	
	$bigramValue = $xmlValues.configuration.CustomerBigram
	$releseValue = $xmlValues.configuration.ReleaseVersion
	$PPPValue = $xmlValues.configuration.PPP
	$PUDValue = $xmlValues.configuration.PUD
	$PFHValue = $xmlValues.configuration.PFH
	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             BIGRAM")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Selected Bigram: $bigramValue")
	$richtextbox1.ScrollToCaret()
	
	Write-Log -Level INFO -Message "***************************************************************"
	Write-Log -Level INFO -Message " Select Bigram------------------"
