$buttonSettings_Click = {
	
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	$selectedBigram = $BigramListBox.SelectedItem
	
	if ($selectedBackupfolder -eq $null -or $selectedBigram -eq $null)
	{
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Please Select Bigram or backupfolder")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
	}
	
	else
	{
		###################################
		# Check backupfolder if encrypted
		###################################	
		
		$AppPaths = (Get-ChildItem -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot" -Recurse -Filter web.config).DirectoryName
		
		
		foreach ($AppPath in $AppPaths)
		{
			
			[XML]$CheckElementXML = Get-Content -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot\$selectedBigram\PPP\Personec_P_web\Lon\web.config"
			
			
		}
		
		[XML]$CheckElementXML = Get-Content -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot\$selectedBigram\PPP\Personec_P_web\Lon\web.config"
		
		if ($CheckElementXML.configuration.appSettings.EncryptedData -ne $null)
		{
			$richtextbox1.Clear()
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("****************************************************************")
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             Backupfolder is encrypted!!!")
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("****************************************************************")
			$richtextbox1.ScrollToCaret()
			
		}
		else
		{
			
			###################################
			# INVENTORY settings
			###################################	
			$UseSSOBackup = (Test-path -Path "$InstallDrive\Visma\install\backup\$selectedBackupfolder\Wwwroot\$selectedBigram\$selectedBigram\Login\Web.config")
			
			if ($UseSSOBackup -eq $true)
			{
				
				[XML]$UseSSO = Get-Content "$InstallDrive\Visma\install\backup\$selectedBackupfolder\Wwwroot\$selectedBigram\$selectedBigram\Login\Web.config" -ErrorAction SilentlyContinue
				
				
				$useSSOValue = $usesso.configuration.appsettings.add.where{ $_.key -eq 'UseSSo' }.value
				$SingleSignOnMethodValue = $usesso.configuration.appsettings.add.where{ $_.key -eq 'SingleSignOnMethod' }.value
				$MultitenantModeValue = $usesso.configuration.appsettings.add.where{ $_.key -eq 'MultitenantMode' }.value
				
				
				$data3 += $object
				
				$result = $data3 | Out-String
				$richtextbox1.Clear()
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("****************************************************************")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             INVENTORY SETTINGS LOGIN         ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("****************************************************************")
				
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             UseSSO = $useSSOValue ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             SingleSignOnMethod = $SingleSignOnMethodValue")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             MultitenantMode = $MultitenantModeValue")
				$richtextbox1.ScrollToCaret()
				Write-Log -Level INFO -Message "***************************************************************"
				Write-Log -Level INFO -Message " INVENTORY SETTINGS LOGIN "
				Write-Log -Level INFO -Message " UseSSO   value = $useSSOValue "
				Write-Log -Level INFO -Message " SingleSignOnMethod   value = $SingleSignOnMethodValue "
				Write-Log -Level INFO -Message " MultitenantMode   value = $MultitenantModeValue "
				Write-Log -Level INFO -Message "***************************************************************"
			}
			
			Else
			{
				
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             Use SSO ")
				$richtextbox1.AppendText("`n")
				$richtextbox1.AppendText("             No web.config present  ")
				$richtextbox1.ScrollToCaret()
				Write-Log -Level INFO -Message "***************************************************************"
				Write-Log -Level INFO -Message " INVENTORY SETTINGS ------------"
				Write-Log -Level INFO -Message "No web.config present for login component"
				Write-Log -Level INFO -Message "***************************************************************"
			}
			
			###################################
			# INVENTORY for license.json
			###################################	
			
			$haveLicensJSON = (Test-path -Path "$InstallDrive\Visma\install\backup\$selectedBackupfolder\Wwwroot\$selectedBigram\PIP\IntegrationApi\license.json")
			
