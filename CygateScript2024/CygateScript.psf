		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Path: ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $InstallDrive\Visma\install\backup\$selectedBackupfolder\")
		$richtextbox1.ScrollToCaret()
		
		Write-Log -Level INFO -Message "******************************************************************************"
		
		Write-Log -Level INFO -Message "Queries for DB upgrade ALREADY created IF WRONG - DELETE!"
		Write-Log -Level INFO -Message "Queries-file:"
		Write-Log -Level INFO -Message "DB_upgrade_Queries.txt"
		Write-Log -Level INFO -Message "Path:"
		Write-Log -Level INFO -Message "$InstallDrive\Visma\install\backup\$selectedBackupfolder\"
		
		
	}
	
	else
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Generate SQL Queries for DB upgrade ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             FILE CREATED ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Queries-file: ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             DB_upgrade_Queries.txt ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Path: ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $InstallDrive\Visma\install\backup\$selectedBackupfolder\")
		$richtextbox1.ScrollToCaret()
		
		Write-Log -Level INFO -Message "******************************************************************************"
		
		Write-Log -Level INFO -Message "Queries for DB upgrade created"
		Write-Log -Level INFO -Message "Queries-file:"
		Write-Log -Level INFO -Message "DB_upgrade_Queries.txt"
		Write-Log -Level INFO -Message "Path:"
		Write-Log -Level INFO -Message "$InstallDrive\Visma\install\backup\$selectedBackupfolder\"
		
		
		
		$SQL_queries | Out-File "$InstallDrive\Visma\install\backup\$selectedBackupfolder\DB_upgrade_Queries.txt" -Force
		
	}
	
	
	
}

$buttonQRRead_Click={
	
	
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	[XML]$xmlValues = Get-Content "$InstallDrive\Visma\install\backup\appsettings\$selectedBigram.XML"
	$QRRead = $selectedBigram + "_QRRead"
	$DB_PPP = $selectedBigram + "_PPP"
	$DB_PFH = $selectedBigram + "_PFH"
	$DB_PUD = $selectedBigram + "_PUD"
	$DB_PAG = $selectedBigram + "_PAG"
	$DB_Neptune = $selectedBigram + "Neptune"
	$Sec_User = $selectedBigram + "_Sec"
	$DBUser_DU = $selectedBigram + "_DashboardUser"
	$DBUser_MU = $selectedBigram + "_MenuUser"
	$DBUser_SU = $selectedBigram + "_SecurityUser"
	$DBUser_NA = $selectedBigram + "_NeptuneAdmin"
