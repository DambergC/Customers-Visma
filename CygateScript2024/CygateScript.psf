$buttonDeleteBigram_Click={
	$folderToDelete = $BigramListBox.SelectedItem
	
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to delete $folderToDelete?"
	$MessageTitle = "Delete Bigram File"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		
		$source = "$InstallDrive\visma\install\backup\$folderToDelete\"
		$richtextbox1.AppendText("Deleting: $source")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
		
		Remove-Item -Path $source -Recurse -Force -ErrorAction SilentlyContinue
		
		Write-Log -Level INFO -Message "Backupfolder $folderToDelete removed"
		update-config
	}
}

$buttonServices_Click={
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Stopping Services ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	
	foreach ($Service in $Services)
	{
		
		$checkservice = Get-Service -Name $Service -ErrorAction SilentlyContinue
		
		if ($checkservice -eq $null)
		{
			
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $Service does not exist ")
			$richtextbox1.ScrollToCaret()
		}
		
		else
		{
			Stop-Service -Name $Service -Force -ErrorAction SilentlyContinue -Verbose
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $Service Stopped ")
			$richtextbox1.ScrollToCaret()
		}
		
		
		
		
	}
}

$buttonIISSite_Click = {
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Stopping Site ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	$checksite = Get-IISSite -Name $selectedBigram
	
	if ($checksite -eq $null)
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $selectedBigram site does not exist ")
		$richtextbox1.ScrollToCaret()
	}
	
	else
	{
		Stop-IISSite -Name $selectedBigram -Verbose -Confirm:$false
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $selectedBigram site Stopped ")
		$richtextbox1.ScrollToCaret()	}

}

$buttonEncrypt_Click = {
	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Encrypting web.config appsettings ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	# Define the path to aspnet_regiis.exe
	$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
	
	# Define the section to encrypt and the path to the web.config file
	$section = "appSettings"
	
	$AppPaths = @()
	
	
	
	$AppPaths = (Get-ChildItem -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot" -Recurse -Filter web.config).DirectoryName
	
	$progressbaroverlay1.Maximum = $apppaths.Count
	$progressbaroverlay1.Step = 1
	$progressbaroverlay1.Value = 0
	
	foreach ($AppPath in $AppPaths)
	{
		# Run the encryption command
		& $AspNetRegIisLocation -pef $section $appPath
		$progressbaroverlay1.PerformStep()
		
		
	}
	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Finished Encrypting web.config ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	
	
	
}

$buttonDecrypt_Click= {
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Decrypting web.config appsettings ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	
	# Define the path to aspnet_regiis.exe
	$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
	
	# Define the section to encrypt and the path to the web.config file
	$section = "appSettings"
	
	$apppaths = @()
	
	$AppPaths = (Get-ChildItem -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot" -Recurse -Filter web.config).DirectoryName
	
	$progressbaroverlay1.Maximum = $apppaths.Count
	$progressbaroverlay1.Step = 1
	$progressbaroverlay1.Value = 0
	
	foreach ($AppPath in $AppPaths)
	{
		# Run the encryption command
		& $AspNetRegIisLocation -pdf $section $appPath
		$progressbaroverlay1.PerformStep()
		
	}
	
	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Finished Decrypting web.config ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
}
