$buttonSaveBigram_Click = {
	
	$BIGRAM_XML = $TB_Bigram.text
	$TB_ReleaseVersion_XML = $TB_ReleaseVersion.text
	$DB_PPP_XML = $TB_DB_PPP_Version.text
	$DB_PUD_XML = $TB_DB_PUD_Version.Text
	$DB_PFH_XML = $TB_DB_PFH_Version.text
	
	$SavePathExist = Test-Path -Path "$InstallDrive\Visma\install\backup\AppSettings"
	
	if ($SavePathExist -eq $false)
	{
		New-Item -Path "$InstallDrive\Visma\install\backup\Appsettings" -ItemType Directory
	}
	
	#Create XML
	$xmlWriter = New-Object System.XMl.XmlTextWriter("$installdrive\Visma\install\backup\Appsettings\$BIGRAM_XML.XML", $null)
	$xmlWriter.Formatting = 'Indented'
	$xmlWriter.Indentation = 1
	$XmlWriter.IndentChar = "`t"
	
	$xmlWriter.WriteStartDocument()
	
	$xmlWriter.WriteStartElement("Configuration") # Configuration Startnode
	
	$xmlWriter.WriteElementString("ConfigVersion", "1.0")
	$xmlWriter.WriteElementString("CustomerBigram", "$BIGRAM_XML")
	$xmlWriter.WriteElementString("InstallDrive", "$InstallDrive")
	$xmlWriter.WriteElementString("ReleaseVersion", "$TB_ReleaseVersion_XML")
	$xmlWriter.WriteElementString("PPP", "$DB_PPP_XML")
	$xmlWriter.WriteElementString("PUD", "$DB_PUD_XML")
	$xmlWriter.WriteElementString("PFH", "$DB_PFH_XML")
	$xmlWriter.WriteEndElement() # Configuration endnode
	$xmlWriter.Flush()
	$xmlWriter.Close()
	
	
	$richtextbox1.AppendText("CREATED/Updated instance: $BIGRAM_XML")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	Write-Log -Level INFO -Message "CREATED/Updated instance: $BIGRAM_XML"
	
	update-config
	
}

