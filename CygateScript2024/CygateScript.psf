	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Selected Bigram: $bigramValue")
	$richtextbox1.ScrollToCaret()
	
	Write-Log -Level INFO -Message "***************************************************************"
	Write-Log -Level INFO -Message " Select Bigram------------------"
	Write-Log -Level INFO -Message "Selected Bigram: $bigramValue"
	Write-Log -Level INFO -Message "***************************************************************"
	$TB_Bigram.Clear()
