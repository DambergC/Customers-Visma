	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Selected backupfolder: $Backupfolder")
	$richtextbox1.ScrollToCaret()
	
	
	
	if ($selectedItems.Count -eq 0)
	{
		$buttonDeleteFolder.Enabled = $false
		$buttonFileBackup.Enabled = $false
	}
	
	else
	{
		$buttonDeleteFolder.Enabled = $true
		$buttonFileBackup.Enabled = $true
	}
	
	
	$SelectedBackupFolderTextbox.Clear()
	$SelectedBackupFolderTextbox.AppendText($BackupFolderListbox.SelectedItem)
	
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	$selectedBigram = $BigramListBox.SelectedItem
	
	$backupExist = Test-Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\Robocopy.log"
	
	if ($backupExist -eq $true)
	{
		$buttonFileBackup.Enabled = $false
	}
	
	else
	{
		$buttonFileBackup.Enabled = $true
	}
}

