:r d:\visma\Install\HRM\PFH\DatabaseServer\Script\SW\$ReleaseVersionXML\mPSFu$PFHXML.sql
GO
:r d:\visma\Install\HRM\PFH\DatabaseServer\Script\SW\$ReleaseVersionXML\mPSFproc.sql
