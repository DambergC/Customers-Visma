	$TB_ReleaseVersion.Clear()
	$TB_ReleaseVersion.AppendText($releseValue)
	$TB_DB_PPP_Version.Clear()
	$TB_DB_PPP_Version.AppendText($PPPValue)
	$TB_DB_PUD_Version.Clear()
	$TB_DB_PUD_Version.AppendText($PUDValue)
	$TB_DB_PFH_Version.Clear()
	$TB_DB_PFH_Version.AppendText($PFHValue)
}

$BackupFolderListbox_SelectedIndexChanged = {
	
	
	
	
	
	$selectedItems = $BackupFolderListbox.SelectedItems
	
	$Backupfolder = $BackupFolderListbox.SelectedItem
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             BACKUPFOLDER")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Selected backupfolder: $Backupfolder")
	$richtextbox1.ScrollToCaret()
	
	
	
	if ($selectedItems.Count -eq 0)
	{
		$buttonDeleteFolder.Enabled = $false
		$buttonFileBackup.Enabled = $false
	}
	
	else
	{
		$buttonDeleteFolder.Enabled = $true
		$buttonFileBackup.Enabled = $true
	}
	
	
	$SelectedBackupFolderTextbox.Clear()
	$SelectedBackupFolderTextbox.AppendText($BackupFolderListbox.SelectedItem)
	
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	$selectedBigram = $BigramListBox.SelectedItem
	
	$backupExist = Test-Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\Robocopy.log"
	
	if ($backupExist -eq $true)
	{
		$buttonFileBackup.Enabled = $false
	}
	
	else
	{
		$buttonFileBackup.Enabled = $true
	}
}

$buttonCreateFolder_Click = {
	
	$foldername = $TB_BackupfolderName.Text
	
	$richtextbox1.AppendText("New Backupfolder created: $foldername")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	
	New-Item -Path "$InstallDrive\visma\install\backup\$foldername" -ItemType directory
	Write-Log -Level INFO -Message "***************************************************************"
	Write-Log -Level INFO -Message " BACKUPFOLDER"
	Write-Log -Level INFO -Message "New Backupfolder created: $foldername"
	Write-Log -Level INFO -Message "***************************************************************"
	update-config
	
}

