		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Stopping Site ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
		
		$checksite = Get-IISSite -Name $selectedBigram
		
		if ($checksite -eq $null)
		{
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $selectedBigram site does not exist ")
			$richtextbox1.ScrollToCaret()
		}
		
		else
		{
			
			Write-Log -Level INFO -Message "***************************************************************"
			Write-Log -Level INFO -Message "Stopping $selectedBigram Site --------------"
			
			
			
			Stop-IISSite -Name $selectedBigram -Confirm:$false
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $selectedBigram site Stopped ")
			$richtextbox1.ScrollToCaret()
		}
		Write-Log -Level INFO -Message "$selectedBigram site Stopped!"
		Write-Log -Level INFO -Message "***************************************************************"
	}
}

$buttonEncrypt_Click = {
	
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	if ($selectedBackupfolder -eq $null -or $selectedBigram -eq $null)
	{
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Please Select Bigram or backupfolder")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
	}
	
	else
	{
		
		
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Encrypting web.config appsettings ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
		$selectedBigram = $BigramListBox.SelectedItem
		$selectedBackupfolder = $BackupFolderListbox.SelectedItem
		
		# Define the path to aspnet_regiis.exe
		$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
		
		# Define the section to encrypt and the path to the web.config file
		$section = "appSettings"
		
		$AppPaths = @()
		
		
		
		$AppPaths = (Get-ChildItem -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot" -Recurse -Filter web.config).DirectoryName
		
		$progressbaroverlay1.Maximum = $apppaths.Count
		$progressbaroverlay1.Step = 1
		$progressbaroverlay1.Value = 0
		
		foreach ($AppPath in $AppPaths)
		{
			# Run the encryption command
			& $AspNetRegIisLocation -pef $section $appPath
			$progressbaroverlay1.PerformStep()
			
			
		}
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Finished Encrypting web.config ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
	}
	
}

$buttonDecrypt_Click = {
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	if ($selectedBackupfolder -eq $null -or $selectedBigram -eq $null)
	{
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Please Select Bigram or backupfolder")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
	}
	
	else
	{
		
		
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Decrypting web.config appsettings ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
		# Define the path to aspnet_regiis.exe
		$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
		
		# Define the section to encrypt and the path to the web.config file
		$section = "appSettings"
		
		$apppaths = @()
		
		$AppPaths = (Get-ChildItem -Path "$InstallDrive\Visma\Install\Backup\$selectedBackupfolder\wwwroot" -Recurse -Filter web.config).DirectoryName
		
		$progressbaroverlay1.Maximum = $apppaths.Count
		$progressbaroverlay1.Step = 1
		$progressbaroverlay1.Value = 0
		
		foreach ($AppPath in $AppPaths)
		{
			# Run the encryption command
			& $AspNetRegIisLocation -pdf $section $appPath
			$progressbaroverlay1.PerformStep()
			
		}
		
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Finished Decrypting web.config ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
	}
}

$buttonStartIISSite_Click = {
	$richtextbox1.Clear()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Starting Site ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	$checksite = Get-IISSite -Name $selectedBigram
	
	if ($checksite -eq $null)
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $selectedBigram site does not exist ")
		$richtextbox1.ScrollToCaret()
	}
	
	else
	{
		
		Write-Log -Level INFO -Message "***************************************************************"
		Write-Log -Level INFO -Message "Stopping $selectedBigram Site --------------"
		
		Start-IISSite -Name $selectedBigram
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $selectedBigram site Started ")
		$richtextbox1.ScrollToCaret()
		Write-Log -Level INFO -Message "$selectedBigram site Started!"
		Write-Log -Level INFO -Message "***************************************************************"
	}
}



$buttonStartServices_Click = {
	
	$selectedBigram = $BigramListBox.SelectedItem
	$selectedBackupfolder = $BackupFolderListbox.SelectedItem
	
	$richtextbox1.Clear()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Starting Service to original mode and status ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	
	
	# Load the XML data from the file
	[XML]$xmlData = Get-Content "$InstallDrive\Visma\Install\backup\$selectedBackupfolder\ServicesRestorePoint.xml"
	
	$progressbaroverlay1.Maximum = $xmlData.Count
	$progressbaroverlay1.Step = 1
	$progressbaroverlay1.Value = 0
	
	
	# Iterate through each service and restart it
	foreach ($service in $xmlData.Objects.Object)
	{
		$serviceName = $service.Property[0]."#text"
		$serviceStartName = $service.Property[1]."#text"
		$serviceStatus = $service.Property[2]."#text"
		$ServiceStartType = $service.Property[3]."#text"
		
		if ($ServiceStartType -eq 'Auto')
		{
			Set-Service -Name $serviceName -StartupType Automatic
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $serviceName set to AUTOMATIC ")
			Write-Log -Level INFO -Message "***************************************************************"
			Write-Log -Level INFO -Message "$serviceName set to AUTOMATIC --------------"
		}
		
		if ($ServiceStartType -eq 'Manual')
		{
			Set-Service -Name $serviceName -StartupType Manual
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $serviceName set to MANUAL ")
			Write-Log -Level INFO -Message "***************************************************************"
			Write-Log -Level INFO -Message "$serviceName set to MANUAL --------------"
		}
		
		if ($ServiceStartType -eq 'Disabled')
		{
			Set-Service -Name $serviceName -StartupType Disabled
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $serviceName set to DISABLED ")
			Write-Log -Level INFO -Message "***************************************************************"
			Write-Log -Level INFO -Message "$serviceName set to DISABLED --------------"
		}
		
		if ($serviceStatus -eq 'Running')
		{
			Start-Service -Name $servicename
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $serviceName STARTED ")
			Write-Log -Level INFO -Message "***************************************************************"
			Write-Log -Level INFO -Message "$serviceName STARTED --------------"
			
			
		}
		
		if ($serviceStartName -ne 'Localsystem')
		{
			write-host "$servicename is running with $serviceStartName"
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $serviceName running with Account ")
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             Notify customer ")
			
			Write-Log -Level INFO -Message "***************************************************************"
			Write-Log -Level INFO -Message "$serviceName running with $serviceStartName "
		}
		
		$progressbaroverlay1.PerformStep()
		
	}
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("             Done...")
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("****************************************************************")
	$richtextbox1.ScrollToCaret()
	
}

$buttonCloseApplicationAndE_Click = {
	
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to close the script and encrypt the backup?"
	$MessageTitle = "Close script"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Start closing script and encrypt backup")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
		
		# Define the path to aspnet_regiis.exe
		$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
		
		# Define the section to encrypt and the path to the web.config file
		$section = "appSettings"
		
		$AppPaths = @()
		
		
		
		$AppPaths = (Get-ChildItem -Path "$InstallDrive\Visma\Install\Backup" -Recurse -Filter web.config).DirectoryName
		
		$progressbaroverlay1.Maximum = $apppaths.Count
		$progressbaroverlay1.Step = 1
		$progressbaroverlay1.Value = 0
		
		foreach ($AppPath in $AppPaths)
		{
			# Run the encryption command
			& $AspNetRegIisLocation -pef $section $appPath
			$progressbaroverlay1.PerformStep()
			
			
		}
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Finished Encrypting web.config ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.ScrollToCaret()
		
		$formTeliaCygatePersonecP.Close()
		
	}
	
	
	
}


