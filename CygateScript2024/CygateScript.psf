$buttonGetThumbprint_Click = {
	
	
	$testCert = Get-ChildItem Cert:\LocalMachine\My
	
	if ($testCert -eq $null)
	{
		$richtextbox1.Clear()
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Get Thumbprint ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             No Certificate installed on this server")
		$richtextbox1.ScrollToCaret()
		
		Write-Log -Level INFO -Message "******************************************************************************"
		Write-Log -Level INFO -Message " Certificate --------------"
		Write-Log -Level INFO -Message "******************************************************************************"
		Write-Log -Level INFO -Message "No Certificate installed on this server......."
		
	}
	
	else
	{
		
		# Define the starting date for the search
		$StartDate = Get-Date
		
		# Define the certificate path
		$CertPath = 'Cert:\LocalMachine\my'
		
		# Retrieve certificate details
		$CertsDetail = Get-ChildItem -Path $CertPath -Recurse | Where-Object {
			$_.PsIsContainer -ne $true
		} | ForEach-Object {
			# Calculate the number of days left until expiration
			$DaysLeft = (New-TimeSpan -Start $StartDate -End $_.NotAfter).Days
			# Format the expiration date
			$FinalDate = Get-Date $_.NotAfter -Format 'dd/MM/yyyy hh:mm'
			# Retrieve intended purposes
			$Usages = $_.Extensions | Where-Object {
				$_.Oid.FriendlyName -eq 'Enhanced Key Usage'
			} | ForEach-Object {
				$_.Format(0) -join ', '
			}
			# Create a custom object with the required details
			[PSCustomObject]@{
				Thumbprint	     = $_.Thumbprint
				Subject		     = $_.Subject
				ExpireDate	     = $FinalDate
				DaysRemaining    = $DaysLeft
				IntendedPurposes = $Usages
			}
		} | Out-GridView -PassThru
		
		$CertsDetail.thumbprint | Set-Clipboard
		
		
		$CertsDetailTP = $CertsDetail.thumbprint
		
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Get Thumbprint ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("****************************************************************")
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Thumbprint: $CertsDetailTP")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Thumbprint also sent to Clipboard")
		$richtextbox1.ScrollToCaret()
		
		Write-Log -Level INFO -Message "******************************************************************************"
		Write-Log -Level INFO -Message " Thumbprint ---------------"
		Write-Log -Level INFO -Message "******************************************************************************"
		
		
		Write-Log -Level INFO -Message "Thumbprint extracted from certificate"
		Write-Log -Level INFO -Message "$CertsDetailTP"
	}
	
}

