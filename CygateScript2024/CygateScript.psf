			Stop-IISSite -Name $selectedBigram -Confirm:$false
			$richtextbox1.AppendText("`n")
			$richtextbox1.AppendText("             $selectedBigram site Stopped ")
			$richtextbox1.ScrollToCaret()
		}
		Write-Log -Level INFO -Message "$selectedBigram site Stopped!"
		Write-Log -Level INFO -Message "***************************************************************"
	}
}

