GO

USE [$DB_PAG] -- Personec Anstallningsguide
GO
CREATE USER [$QRRead] FOR LOGIN [$QRRead]
GO
ALTER ROLE [db_datareader] ADD MEMBER [$QRRead]
GO
#------------------------------------------------#
"@
		
		
		
		

