		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             QRRead_Queries.txt ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             Path: ")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("             $InstallDrive\Visma\install\backup\$selectedBackupfolder\")
		$richtextbox1.ScrollToCaret()
		
		Write-Log -Level INFO -Message "******************************************************************************"
		Write-Log -Level INFO -Message "Queries for QR Read ALREADY created! IF WRONG - DELETE!"
		Write-Log -Level INFO -Message "******************************************************************************"
		Write-Log -Level INFO -Message "Queries for QR Read ALREADY created! IF WRONG - DELETE!"
		Write-Log -Level INFO -Message "Queries-file:"
